# Copy to `.env.local` and set your rotated Must LiteLLM credential there.
# Do not commit the real bearer token. The Codex alias is configurable if the gateway uses another model name.
MUST_LITELLM_BASE_URL=https://litellm.must.company/v1
MUST_LITELLM_API_KEY=your-rotated-token
MUST_LITELLM_MODEL=codex
