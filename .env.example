# Copy to `.env.local` and paste your real key. `.env.local` is git-ignored.
#   cp .env.example .env.local
# Get a key at https://console.anthropic.com  (starts with sk-ant-)
# Without a key the app still returns on-chain facts + events; the AI report/alerts are skipped.

ANTHROPIC_API_KEY=sk-ant-your-key-here
