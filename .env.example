# Copy to `.env.local` and set your Anthropic API key there.
# Keep the key server-side and never commit it. Set ANTHROPIC_MODEL to a model enabled for your account.
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_WORKSPACE_ID=your-anthropic-workspace-id
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: use your own RPC provider endpoint(s) if public endpoints are unreachable.
# Add comma-separated URLs for failover. Configure only the chain(s) you need.
# POLYGON_RPC_URLS=https://your-polygon-rpc.example,https://backup-polygon-rpc.example
# ETHEREUM_RPC_URLS=https://your-ethereum-rpc.example
# BASE_RPC_URLS=https://your-base-rpc.example
# ARBITRUM_RPC_URLS=https://your-arbitrum-rpc.example
# OPTIMISM_RPC_URLS=https://your-optimism-rpc.example
# BNB_RPC_URLS=https://your-bnb-rpc.example

# Staff review console (use a unique password and a cryptographically random session secret).
TRUSTLENS_ADMIN_PASSWORD=replace-with-a-long-unique-password
TRUSTLENS_ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Supabase PostgREST storage. The service-role key is server-only; never use an anon key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-server-only-secret-key

# Token discovery (server-side only)
COINMARKETCAP_API_KEY=your-coinmarketcap-api-key
TRUSTLENS_ALERT_CRON_SECRET=replace-with-a-long-random-secret

# Scheduled monitor endpoint authorization. Configure the scheduler to POST
# /api/cron/monitor with Authorization: Bearer <secret>.
TRUSTLENS_MONITOR_CRON_SECRET=replace-with-a-different-32-character-secret
